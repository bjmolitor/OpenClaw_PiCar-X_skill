# Navis listen daemon example config (no secrets)
NAVIS_WAKE_PHRASES="navis 01,navis null eins,navis null 1,navis eins"
NAVIS_WAKE_DEBUG=1
NAVIS_SAMPLE_RATE=16000
NAVIS_SILENCE_SECONDS=2.0
NAVIS_CONVO_MAX_TURNS=1
NAVIS_CONVO_START_TIMEOUT=6
NAVIS_VAD_MODE=2
NAVIS_ARECORD_DEVICE=plughw:3,0
NAVIS_ENABLE_BEEP=1
NAVIS_SPK_DEVICE=default
NAVIS_OPENCLAW_BIN=/usr/local/bin/openclaw
NAVIS_OPENCLAW_NODE=
NAVIS_OPENCLAW_AGENT=main
NAVIS_OPENCLAW_SESSION_ID=main
NAVIS_OPENCLAW_TIMEOUT=30
PYTHONUNBUFFERED=1
NODE_OPTIONS=
# Set your own key locally; do NOT commit real credentials
OPENAI_API_KEY=
NAVIS_TTS_BACKEND=openai
NAVIS_TTS_MODEL=gpt-4o-mini-tts
NAVIS_TTS_VOICE=alloy
NAVIS_TTS_INSTRUCTIONS="Sprich klar und natuerlich auf Deutsch."
NAVIS_ENABLE_ROBOT_HAT_SPEAKER=1
NAVIS_WAKE_VAD_MODE=0
NAVIS_WAKE_VAD_FRAME_MS=30
NAVIS_WAKE_VAD_HOLD_SECONDS=1.5
NAVIS_WAKE_VAD_GATE=0
NAVIS_BEEP_AFTER_RESPONSE=0
